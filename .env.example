# single_pick_ai integration
# URL of the single_pick_ai FastAPI server that exposes the read-only KEIBA LAB
# prediction API (/api/lab/*). The client fetches real races from here.
#
# Dev (vite proxy handles /api/lab, so leave the client base empty):
#   SINGLE_PICK_AI_URL=http://127.0.0.1:8000
# Prod (client fetches single_pick_ai directly — set the browser-visible base;
# single_pick_ai must allow this origin via CORS):
#   VITE_SINGLE_PICK_AI_BASE=https://your-single-pick-ai-host
SINGLE_PICK_AI_URL=http://127.0.0.1:8000
VITE_SINGLE_PICK_AI_BASE=

# --- Manus platform (server) — required only to run the full Node server ---
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# JWT_SECRET=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_APP_ID=
